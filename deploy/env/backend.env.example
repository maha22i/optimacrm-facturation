# ─────────────────────────────────────────────────────────────────────────────
# Modèle de deploy/env/backend.env (le fichier réel n'est pas versionné).
#
# Chargé tel quel dans le conteneur via `env_file` : les valeurs ne sont ni
# interpolées ni réinterprétées, ce qui permet d'y mettre le JSON Firebase
# sur une seule ligne, exactement comme dans le .env de développement.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3001
TZ=Europe/Paris

# Un seul proxy entre le client et l'app (le nginx de l'hôte).
TRUST_PROXY=1

# Rôle applicatif restreint au DML et soumis au RLS — jamais `postgres`.
DATABASE_URL=postgresql://optimacrm_app:REMPLACER@postgres:5432/optimacrm

JWT_SECRET=REMPLACER
JWT_EXPIRES_IN=24h

# Origines autorisées par CORS, et bases des liens envoyés par email
# (signature de devis côté CRM, réinitialisation de mot de passe côté portail).
FRONTEND_URL=https://facturationgroupinnov.optimacrm.fr
CLIENT_PORTAL_URL=https://clientgroupinnov.optimacrm.fr

# Clé AES-256-GCM chiffrant les mots de passe IMAP stockés en base.
# La modifier rend illisibles les configurations email déjà enregistrées.
EMAIL_ENCRYPTION_KEY=REMPLACER
EMAIL_POLLING_ENABLED=true
EMAIL_POLL_CRON=* * * * *

FIREBASE_STORAGE_BUCKET=REMPLACER
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account", ...}
